FLEET_TRUSTED_PROXY_HOPS=1
FLEET_DEVICE_CHECKIN_SECONDS=300
FLEET_MAX_RECORDS=10000
FLEET_ENROLLMENT_GLOBAL_RATE_LIMIT=100
FLEET_ENROLLMENT_RATE_LIMIT=10
FLEET_ENROLLMENT_RATE_WINDOW_SECONDS=60
