# Place the limit zone in nginx's http {} block.
limit_req_zone $binary_remote_addr zone=sugarfleet_register:10m rate=5r/m;

server {
    listen 443 ssl http2;
    server_name fleet.sugarclock.com;

    # Configure ssl_certificate and ssl_certificate_key for this hostname.

    location = /device/v1/register {
        limit_req zone=sugarfleet_register burst=5 nodelay;
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    }
}
